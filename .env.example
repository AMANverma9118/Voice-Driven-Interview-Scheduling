NODE_ENV=development
PORT=3000

# MongoDB. Either variable works. Include a database name, or set DB_NAME.
DATABASE_URL=mongodb://127.0.0.1:27017/interview_scheduler
# MONGODB_URI=
DB_NAME=interview_scheduler
COMPANY_NAME=Interview Desk
APP_URL=http://localhost:3000
# On Render, set APP_URL to the Vercel site, for example https://your-desk.vercel.app
# Leave CLIENT_ORIGIN empty while developing. On Render, set it to the same Vercel address.
# CLIENT_ORIGIN=
JWT_SECRET=replace-with-a-long-random-string

# Admin login. The password is hashed before it is stored in MongoDB.
# Use at least 8 characters. Restart the server after changing these.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Google reCAPTCHA v2 checkbox keys.
# These public test keys always pass and show a testing warning. Replace them.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Optional email verification. Without SMTP, the verification link is returned to the browser.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Optional Twilio voice calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Google Calendar. GOOGLE_CREDENTIALS is the service account JSON on one line.
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS=

# Optional server-side microphone interview
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
SOX_PATH=
